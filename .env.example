# ============================================================
# DJANGO CORE SETTINGS
# ============================================================

DJANGO_SECRET_KEY=USE-A-REAL-LONG-SECRET-KEY-HERE
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=ryacksonfungo.alwaysdata.net,mysql-ryacksonfungo.alwaysdata.net,localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Nairobi


# ============================================================
# DATABASE - ALWAYS DATA MYSQL
# ============================================================

DB_ENGINE=django.db.backends.mysql
DB_NAME=ryacksonfungo_dream
DB_USER=ryacksonfungo
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_HOST=mysql-ryacksonfungo.alwaysdata.net
DB_PORT=3306


# ============================================================
# CORS / FRONTEND
# ============================================================

CORS_ALLOWED_ORIGINS=https://ryacksonfungo.alwaysdata.net,http://localhost:3000,http://localhost:5173

CSRF_TRUSTED_ORIGINS=https://ryacksonfungo.alwaysdata.net,http://localhost:3000,http://localhost:5173


# ============================================================
# M-PESA / DARAJA
# ============================================================

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=PUT-YOUR-KEY-HERE
MPESA_CONSUMER_SECRET=PUT-YOUR-SECRET-HERE
MPESA_SHORTCODE=174379
MPESA_PASSKEY=PUT-YOUR-PASSKEY-HERE
MPESA_CALLBACK_URL=https://ryacksonfungo.alwaysdata.net/api/mpesa/callback/


# ============================================================
# BOOKING SETTINGS
# ============================================================

BOOKING_HOLD_MINUTES=15


# ============================================================
# EMAIL
# ============================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR-GMAIL-ADDRESS
EMAIL_HOST_PASSWORD=YOUR-GMAIL-APP-PASSWORD
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=YOUR-GMAIL-ADDRESS
ADMIN_NOTIFY_EMAIL=YOUR-GMAIL-ADDRESS